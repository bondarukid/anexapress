# =============================================================================
# Example environment variables for AnexaPress
# Copy this file to `.env.local` and fill in real values.
# Do NOT commit `.env.local` or any file with real secrets — only this example.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# `NEXT_PUBLIC_SUPABASE_*` are derived from these in next.config.ts, so you only
# set the non-public variants here.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — server-only, NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Firebase (web) — used client-side for analytics/performance.
# `NEXT_PUBLIC_FIREBASE_*` are derived from these in next.config.ts.
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# -----------------------------------------------------------------------------
# GlitchTip (Sentry-compatible) error monitoring
# DSN is exposed to the browser as NEXT_PUBLIC_SENTRY_DSN via next.config.ts.
# Use https:// to match your TLS server.
# -----------------------------------------------------------------------------
SENTRY_DSN=https://your-public-key@glitchtip.bondarukid.com/your-project-id
# Build-time only — used by withSentryConfig to upload source maps. Generate it
# in your GlitchTip profile. Leave empty in dev if you don't need source maps.
SENTRY_AUTH_TOKEN=your-glitchtip-auth-token

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public base URL of the site (apex / marketing hostname label; optional when platform URL is set).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Platform subdomain — entire SaaS (marketing, auth, dashboard). Optional in dev:
# if unset, the app runs on a single host (e.g. http://localhost:3000).
NEXT_PUBLIC_PLATFORM_URL=http://platform.localhost:3000
PLATFORM_HOST=platform.localhost

# Apex hostname that redirects to the platform subdomain (e.g. your-domain.com in production).
# In local dev with platform routing: APEX_HOST=localhost
APEX_HOST=localhost

# Documentation subdomain (marketing links + proxy redirects).
# Optional: if unset on localhost, derived from NEXT_PUBLIC_SITE_URL as http://docs.localhost:{port}
NEXT_PUBLIC_DOCS_URL=http://docs.localhost:3000
DOCS_HOST=docs.localhost

# -----------------------------------------------------------------------------
# Feature flags (tenant / site modes)
# Set to "true" or "false". When false, schema stays the same — only UX and guards change.
# -----------------------------------------------------------------------------
# Allow users to create/join multiple workspaces.
NEXT_PUBLIC_ENABLE_MULTI_WORKSPACE=true
ENABLE_MULTI_WORKSPACE=true

# Allow multiple sites per workspace (when false, only the default `main` site is used).
NEXT_PUBLIC_ENABLE_MULTI_SITE=true
ENABLE_MULTI_SITE=true
